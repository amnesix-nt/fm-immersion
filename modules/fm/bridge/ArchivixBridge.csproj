<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Plugin BepInEx 6 (IL2CPP) en lecture seule pour Football Manager 27.
    Se compile contre les DLL d'interop générées par BepInEx dans le dossier du jeu : elles appartiennent à
    l'éditeur et ne sont jamais versionnées ni publiées. Compilation avec le jeu (voir README.md) :
      dotnet build -c Release -p:FMDir="G:\Steam\steamapps\common\Football Manager 27"
    Sans le jeu (CI) : dotnet build -c Release -p:Stubs=true (modèles de compilation de stubs/).
  -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>ArchivixBridge</AssemblyName>
    <RootNamespace>Archivix</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Version>0.6.4</Version>
    <FMDir Condition="'$(FMDir)' == ''">$(FM27_DIR)</FMDir>
    <FMDir Condition="'$(FMDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Football Manager 27</FMDir>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\*.cs" />
  </ItemGroup>
  <!-- Compilation sans le jeu (CI) : -p:Stubs=true. BepInEx et Il2CppInterop viennent de NuGet (logiciels libres),
       les DLL d'interop du jeu sont remplacées par nos modèles de compilation (stubs/, signatures seulement). -->
  <PropertyGroup Condition="'$(Stubs)' == 'true'">
    <RestoreAdditionalProjectSources>https://nuget.bepinex.dev/v3/index.json</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup Condition="'$(Stubs)' == 'true'">
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.791" PrivateAssets="all" ExcludeAssets="runtime" />
    <ProjectReference Include="stubs\UnityEngine.CoreModule\UnityEngine.CoreModule.csproj" Private="false" Aliases="UnityCore" />
    <ProjectReference Include="stubs\Il2Cppmscorlib\Il2Cppmscorlib.csproj" Private="false" />
    <ProjectReference Include="stubs\SI.Core\SI.Core.csproj" Private="false" />
    <ProjectReference Include="stubs\SI.Bindable\SI.Bindable.csproj" Private="false" />
    <ProjectReference Include="stubs\SI.Bindable.Reference.Core\SI.Bindable.Reference.Core.csproj" Private="false" />
    <ProjectReference Include="stubs\SI.Interop\SI.Interop.csproj" Private="false" />
    <ProjectReference Include="stubs\FM.UI\FM.UI.csproj" Private="false" />
    <ProjectReference Include="stubs\UnityEngine.UIElementsModule\UnityEngine.UIElementsModule.csproj" Private="false" />
    <ProjectReference Include="stubs\UnityEngine.TextCoreTextEngineModule\UnityEngine.TextCoreTextEngineModule.csproj" Private="false" />
    <ProjectReference Include="stubs\UnityEngine.TextRenderingModule\UnityEngine.TextRenderingModule.csproj" Private="false" />
    <ProjectReference Include="stubs\Unity.InputSystem\Unity.InputSystem.csproj" Private="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(Stubs)' != 'true'">
    <Reference Include="$(FMDir)\BepInEx\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(FMDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(FMDir)\BepInEx\core\Il2CppInterop.Runtime.dll" Private="false" />
    <!-- Alias : cette DLL expose publiquement System.Runtime.CompilerServices.NullableAttribute (conflit CS0656). -->
    <Reference Include="$(FMDir)\BepInEx\interop\UnityEngine.CoreModule.dll" Private="false" Aliases="UnityCore" />
    <Reference Include="$(FMDir)\BepInEx\interop\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(FMDir)\BepInEx\interop\SI.Core.dll" Private="false" />
    <Reference Include="$(FMDir)\BepInEx\interop\SI.Bindable.dll" Private="false" />
    <Reference Include="$(FMDir)\BepInEx\interop\SI.Bindable.Reference.Core.dll" Private="false" />
    <Reference Include="$(FMDir)\BepInEx\interop\SI.Interop.dll" Private="false" />
    <Reference Include="$(FMDir)\BepInEx\interop\FM.UI.dll" Private="false" />
    <Reference Include="$(FMDir)\BepInEx\interop\UnityEngine.UIElementsModule.dll" Private="false" />
    <Reference Include="$(FMDir)\BepInEx\interop\UnityEngine.TextCoreTextEngineModule.dll" Private="false" />
    <Reference Include="$(FMDir)\BepInEx\interop\UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="$(FMDir)\BepInEx\interop\Unity.InputSystem.dll" Private="false" />
  </ItemGroup>
</Project>
